# Central de Ocorrências v1.1.0 — copie para .env e preencha

PORT=3000
PUBLIC_URL=https://atendimento.mcs.ind.br
# Número de proxies reversos à frente (Nginx/Traefik = 1). Necessário p/ rate limit por IP correto.
TRUST_PROXY=1

# Identidade exibida na página
BRAND_NAME=Sua Empresa
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
PRIVACY_URL=
PROTOCOL_PREFIX=MCS

# Dados (banco SQLite + fotos). No Docker, monte este caminho como volume.
DATA_DIR=./data
# Troque por um texto aleatório (usado para anonimizar o IP)
IP_SALT=troque-este-salt

# Tiny ERP (API v2 por token). Deixe vazio para desligar.
TINY_TOKEN=
TINY_BASE_URL=https://api.tiny.com.br/api2

# Telegram (aviso a cada nova ocorrência). Deixe vazio para desligar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail de confirmação. Sem SMTP_HOST, o envio é apenas registrado no log.
SMTP_HOST=mail.mcs.ind.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=atendimento@mcs.ind.br
SMTP_PASS=
# Só preencha se o envio falhar com erro de certificado ("does not match certificate's altnames")
SMTP_TLS_SERVERNAME=
MAIL_FROM=MCS Brasil <atendimento@mcs.ind.br>

# Painel interno (/painel). O PRIMEIRO gerente é criado a partir destas variáveis, só se ainda não houver usuários.
# Depois do primeiro acesso, remova ADMIN_PASSWORD: as demais contas são criadas dentro do painel.
ADMIN_NAME=Gerente
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Duração do login, em horas
SESSION_HOURS=12

# Mercado Livre (reclamações) — v1.2.0. Deixe vazio para desligar.
# No app do Mercado Livre, inclua a URL de redirecionamento: https://atendimento.mcs.ind.br/api/ml/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcionais: ML_REDIRECT_URI=...  ML_POLL_MINUTES=3

# Rotinas (v1.3.0) — todas opcionais
# Hora do resumo diário no Telegram (0-23, horário de TZ_LOCAL). Use -1 para desligar.
RESUMO_HORA=8
TZ_LOCAL=America/Sao_Paulo
# Quantos backups diários do banco guardar
BACKUP_MANTER=14

# Privacidade / LGPD (v1.4.0) — preenchem a página /privacidade.html
PRIVACY_CONTROLADOR=
PRIVACY_CNPJ=
# E-mail para pedidos dos titulares (se vazio, usa SUPPORT_EMAIL)
PRIVACY_CONTATO=
# Meses depois de resolvida para anonimizar sozinha (0 = não apaga sozinho)
RETENCAO_MESES=0

# ---- Pesquisa de satisfação (v1.6.0) ----
# E-mail ao cliente do formulário pedindo uma nota de 1 a 5 depois de resolvida (false = desligada)
PESQUISA_SATISFACAO=true
# Horas depois de marcar como resolvida para enviar (dá tempo de corrigir um "resolvida" por engano)
PESQUISA_HORAS=2
