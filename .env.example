# Central de Ocorrências v1.0.3 — copie para .env e preencha

PORT=3000
PUBLIC_URL=https://atendimento.mcs.ind.br
# Número de proxies reversos à frente (Nginx/Traefik = 1). Necessário p/ rate limit por IP correto.
TRUST_PROXY=1

# Identidade exibida na página
BRAND_NAME=Sua Empresa
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
PRIVACY_URL=
PROTOCOL_PREFIX=MCS

# Dados (banco SQLite + fotos). No Docker, monte este caminho como volume.
DATA_DIR=./data
# Troque por um texto aleatório (usado para anonimizar o IP)
IP_SALT=troque-este-salt

# Tiny ERP (API v2 por token). Deixe vazio para desligar.
TINY_TOKEN=
TINY_BASE_URL=https://api.tiny.com.br/api2

# Telegram (aviso a cada nova ocorrência). Deixe vazio para desligar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail de confirmação. Sem SMTP_HOST, o envio é apenas registrado no log.
SMTP_HOST=mail.mcs.ind.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=atendimento@mcs.ind.br
SMTP_PASS=
# Só preencha se o envio falhar com erro de certificado ("does not match certificate's altnames")
SMTP_TLS_SERVERNAME=
MAIL_FROM=MCS Brasil <atendimento@mcs.ind.br>
